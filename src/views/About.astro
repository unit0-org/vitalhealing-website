---
import Base from '../layouts/Base.astro';
import { t, path, type Lang } from '../i18n';
import { site } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const a = d.about;
---
<Base lang={lang} route="about" title={d.meta.about.title} description={d.meta.about.description}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">{a.hero.eyebrow}</span>
        <h1>{a.hero.title}</h1>
        <p class="lede">{a.hero.lede}</p>
      </div>
      <div class="photo">
        <div class="block" aria-hidden="true"></div>
        <img src="/images/dianeris-portrait.webp" alt={a.hero.photoAlt} width="897" height="1024" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container narrow story">
      {a.chapters.map((c, i) => (
        <article class="chapter">
          <span class="chap-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h2>{c.title}</h2>
          {c.paras.map((p) => <p>{p}</p>)}
        </article>
      ))}
    </div>
  </section>

  <section class="section section--sage">
    <div class="container narrow">
      <span class="eyebrow">{a.philosophy.eyebrow}</span>
      <blockquote class="quote"><p>“{a.philosophy.quote}”</p></blockquote>
      <p>{a.philosophy.text}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">{a.approach.eyebrow}</span>
      <h2 class="approach-title">{a.approach.title}</h2>
      <ul class="approach">
        {a.approach.items.map((i) => (
          <li class="card"><h3>{i.title}</h3><p>{i.text}</p></li>
        ))}
      </ul>
      <p class="anecdote">{a.approach.story}</p>
    </div>
  </section>

  <section class="section section--white">
    <div class="container two">
      <div>
        <span class="eyebrow">{a.today.eyebrow}</span>
        <h2>{a.today.title}</h2>
        <ul class="leaves">
          {a.today.items.map((i) => <li>{i}</li>)}
        </ul>
        <p class="kitchen">{a.kitchen}</p>
      </div>
      <aside class="cred">
        <img src="/images/iin-inhc-badge.webp" alt={a.credential.badgeAlt} width="120" height="120" loading="lazy" />
        <span class="eyebrow">{a.credential.eyebrow}</span>
        <h3>{a.credential.title}</h3>
        <p>{a.credential.text}</p>
        <a class="btn btn--ghost" href={site.credentialUrl} target="_blank" rel="noopener">{a.credential.cta}</a>
      </aside>
    </div>
  </section>

  <section class="section section--forest">
    <div class="container narrow center">
      <blockquote class="quote quote--light"><p>{a.closing.quote}</p></blockquote>
      <div class="btn-row center-row">
        <a class="btn btn--light btn--marked" href={site.bookingUrl} target="_blank" rel="noopener">{a.closing.cta}</a>
        <a class="link-light" href={path('masterclass', lang)}>{d.home.masterclass.cta} →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(40px, 7vw, 96px); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .photo { position: relative; max-width: 420px; width: 100%; justify-self: end; }
  .photo img { position: relative; aspect-ratio: 4 / 5; object-fit: cover; object-position: center 20%; width: 100%; }
  .block { position: absolute; inset: -24px 24px 24px -24px; background: var(--sage); }

  .story { display: grid; gap: var(--space-4); }
  .chapter h2 { font-size: clamp(26px, 3vw, 34px); }
  .chap-num { display: block; font-family: var(--font-display); color: var(--leaf); font-size: 20px; letter-spacing: 0.1em; margin-bottom: var(--space-1); }

  .quote { margin: 0 0 var(--space-3); }
  .quote p { font-family: var(--font-display); color: var(--forest); font-size: clamp(24px, 3vw, 32px); line-height: 1.35; margin: 0; }
  .quote--light p { color: var(--white); }

  .approach-title { max-width: 24ch; }
  .approach { list-style: none; padding: 0; margin: var(--space-4) 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
  .approach p { margin: 0; }
  .anecdote { max-width: 760px; font-family: var(--font-display); color: var(--forest); font-size: 21px; line-height: 32px; border-top: 3px solid var(--line); padding-top: var(--space-3); }

  .two { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .leaves { list-style: none; padding: 0; margin: var(--space-3) 0; display: grid; gap: var(--space-2); }
  .leaves li { position: relative; padding-left: 36px; }
  .leaves li::before { content: ''; position: absolute; left: 0; top: 5px; width: 20px; height: 20px; background: var(--leaf); border-radius: 0 100% 0 100%; }
  .kitchen { font-style: italic; }
  .cred { background: var(--cream); border-radius: var(--radius-md); padding: var(--space-3); }
  .cred img { margin-bottom: var(--space-2); }

  .center { text-align: center; }
  .center-row { justify-content: center; }
  .link-light { color: var(--white); font-weight: 700; }
  .link-light:hover { color: var(--sage); }

  @media (max-width: 900px) {
    .hero-grid, .two { grid-template-columns: 1fr; }
    .photo { justify-self: center; max-width: 340px; margin-left: 24px; }
    .approach { grid-template-columns: 1fr; }
  }
</style>
