---
import Base from '../layouts/Base.astro';
import Stories from '../components/Stories.astro';
import RegisterForm from '../components/RegisterForm.astro';
import { t, path, type Lang } from '../i18n';
import { masterclass } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const m = d.masterclass;
const date = masterclass.date
  ? new Intl.DateTimeFormat(lang === 'es' ? 'es' : 'en-CA', {
      weekday: 'long', day: 'numeric', month: 'long', hour: 'numeric', minute: '2-digit',
      timeZone: 'America/Vancouver',
    }).format(new Date(masterclass.date)) + ` ${masterclass.timeZoneLabel}`
  : null;
---
<Base lang={lang} route="masterclass" title={d.meta.masterclass.title} description={d.meta.masterclass.description}>
  <!-- Hero + form -->
  <section class="hero section--forest">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow eyebrow--leaf">{m.hero.eyebrow}</span>
        <h1>{m.hero.title}</h1>
        <p class="lede">{m.hero.sub}</p>
        <dl class="facts">
          <div><dt>{m.hero.dateLabel}</dt><dd>{date ?? m.hero.dateTBA}</dd></div>
          <div><dt>{m.hero.formatLabel}</dt><dd>{m.hero.format}</dd></div>
        </dl>
      </div>
      <RegisterForm lang={lang} />
    </div>
  </section>

  <!-- Problem -->
  <section class="section section--white">
    <div class="container narrow">
      <h2>{m.problem.title}</h2>
      <ul class="checks">
        {m.problem.items.map((i) => <li>{i}</li>)}
      </ul>
      <p class="close">{m.problem.close}</p>
      <aside class="did-you-know">
        <h3>{m.problem.didYouKnow.titleStart} <mark class="mark">{m.problem.didYouKnow.titleMark}</mark>{m.problem.didYouKnow.titleEnd}</h3>
        <p>{m.problem.didYouKnow.text}</p>
      </aside>
    </div>
  </section>

  <!-- What you'll learn -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">{m.learn.eyebrow}</span>
      <h2 class="learn-title">{m.learn.title}</h2>
      <ol class="learn">
        {m.learn.items.map((i, n) => (
          <li class="card">
            <span class="num" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
            <h3>{i.title}</h3>
            <p>{i.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- For you if -->
  <section class="section section--sage">
    <div class="container narrow">
      <h2>{m.forYou.title}</h2>
      <ul class="leaves">
        {m.forYou.items.map((i) => <li>{i}</li>)}
      </ul>
    </div>
  </section>

  <!-- Host -->
  <section class="section section--white">
    <div class="container host">
      <img src="/images/dianeris-portrait.webp" alt={d.about.hero.photoAlt} width="897" height="1024" loading="lazy" />
      <div>
        <span class="eyebrow">{m.host.eyebrow}</span>
        <h2>{m.host.title}</h2>
        <p>{m.host.text}</p>
        <a href={path('about', lang)}>{m.host.cta} →</a>
      </div>
    </div>
  </section>

  <!-- Stories -->
  <section class="section">
    <div class="container">
      <h2>{m.storiesTitle}</h2>
      <div class="gap"><Stories lang={lang} pick={[0, 1, 2]} /></div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--white">
    <div class="container narrow">
      <h2>{m.faq.title}</h2>
      <div class="faq">
        {m.faq.items.map((i) => (
          <details>
            <summary>{i.q}</summary>
            <p>{i.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final -->
  <section class="section section--forest">
    <div class="container narrow center">
      <h2>{m.final.title}</h2>
      <p class="lede">{m.final.text}</p>
      <a class="btn btn--light btn--marked" href="#register">{m.final.cta}</a>
    </div>
  </section>
</Base>

<style>
  /* First fold: copy + form fit the screen under the 74px header; sizes follow the viewport height */
  .hero { min-height: calc(100svh - 74px); display: flex; align-items: center; padding-block: clamp(24px, 4vh, 56px); }
  .hero-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .hero h1 { font-size: clamp(34px, min(4.6vw, 6.6vh), 58px); margin-bottom: clamp(12px, 2.4vh, 24px); }
  .hero .lede { color: var(--on-forest); font-size: clamp(17px, 2.5vh, 21px); line-height: 1.5; margin-bottom: 0; max-width: 34em; }
  .facts { margin: clamp(16px, 3vh, 32px) 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .facts div { border-left: 0; padding-top: var(--space-2); border-top: 2px solid rgba(255, 255, 255, 0.25); }
  .facts dt { font-size: 13px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--leaf); }
  .facts dd { margin: 4px 0 0; font-size: 18px; color: var(--white); }

  .checks, .leaves { list-style: none; padding: 0; margin: var(--space-3) 0; display: grid; gap: var(--space-2); }
  .checks li, .leaves li { position: relative; padding-left: 40px; font-size: 19px; line-height: 29px; color: var(--forest); }
  .checks li::before { content: ''; position: absolute; left: 0; top: 3px; width: 24px; height: 24px; border-radius: 50%; background: var(--sage); }
  .checks li::after { content: ''; position: absolute; left: 8px; top: 9px; width: 6px; height: 10px; border: solid var(--forest); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .leaves li::before { content: ''; position: absolute; left: 2px; top: 4px; width: 22px; height: 22px; background: var(--leaf); border-radius: 0 100% 0 100%; }
  .close { font-family: var(--font-display); font-size: 24px; line-height: 34px; color: var(--forest); margin-top: var(--space-3); }
  /* Names the stage for women who recognise the symptoms but not the word "perimenopausia" */
  .did-you-know { margin-top: var(--space-4); background: var(--sage); border-radius: var(--radius-md); padding: var(--space-4) var(--space-3); text-align: center; }
  .did-you-know h3 { font-size: clamp(26px, 3.2vw, 34px); line-height: 1.25; margin: 0 auto var(--space-2); max-width: 18em; }
  .did-you-know p { margin: 0 auto; max-width: 30em; font-size: 18px; line-height: 28px; color: var(--slate); }

  .learn-title { max-width: 22ch; }
  .learn { list-style: none; padding: 0; margin: var(--space-4) 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
  .num { display: block; font-family: var(--font-display); font-size: 40px; line-height: 1; color: var(--leaf); margin-bottom: var(--space-2); }
  .learn p { margin: 0; }

  .host { display: grid; grid-template-columns: 340px 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .host img { aspect-ratio: 4 / 5; object-fit: cover; object-position: center 20%; width: 100%; }
  .host a { font-weight: 700; }

  .gap { margin-top: var(--space-4); }

  .faq { margin-top: var(--space-3); border-top: 3px solid var(--line); }
  details { border-bottom: 3px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: var(--space-2) 40px var(--space-2) 0; position: relative; font-family: var(--font-display); color: var(--forest); font-size: 20px; line-height: 30px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 4px; top: 50%; transform: translateY(-50%); font-family: var(--font-sans); font-size: 28px; color: var(--leaf-deep); }
  details[open] summary::after { content: '–'; }
  details p { padding-bottom: var(--space-2); margin: 0; }

  .center { text-align: center; }
  .center .lede { color: var(--on-forest); }
  .center .btn { margin-top: 24px; }

  @media (max-width: 900px) {
    .hero { min-height: 0; }
    .facts { grid-template-columns: 1fr; gap: var(--space-2); }
    .hero-grid, .host { grid-template-columns: 1fr; }
    .learn { grid-template-columns: 1fr; }
    .host img { max-width: 320px; }
  }
</style>
